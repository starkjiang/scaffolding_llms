# Copy to .env and fill in ONE provider. Leave both empty to run in offline mock mode.
LLM_PROVIDER=mock             # anthropic | openai | mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Models. CHECK THESE BEFORE A WORKSHOP — IDs retire on a published schedule.
#   OpenAI:    https://developers.openai.com/api/docs/models
#   Anthropic: https://platform.claude.com/docs/en/models/overview
#
# small = the cheap tier: classify, extract, route
# large = the capable tier: draft, judge, run the agent loop
# ---------------------------------------------------------------------------
LLM_MODEL_SMALL=gpt-6-luna
LLM_MODEL_LARGE=gpt-6.1-sol
# anthropic example: LLM_MODEL_SMALL=claude-haiku-5-5 / LLM_MODEL_LARGE=claude-sonnet-5-5

# ---------------------------------------------------------------------------
# Parameters. Current models have been removing these, so the repo sends a
# conservative set and drops whatever the API objects to (see scaffold/llm.py).
# ---------------------------------------------------------------------------
# OpenAI reasoning models default to medium reasoning effort, which makes the
# labs slower and dearer than they need to be. Try "low" first; if your model
# supports it, "none" is right for classification and extraction. An
# unsupported value is dropped automatically with a note, so it is safe to try.
OPENAI_REASONING_EFFORT=low

# temperature is restricted on OpenAI reasoning models, and on Claude 4.7+ a
# non-default value returns a 400 (the Python SDK v1.0+ removed it outright).
# Set to 1 ONLY if you have pinned an older model that still accepts it.
# OPENAI_SEND_TEMPERATURE=0
# ANTHROPIC_SEND_TEMPERATURE=0

WORKSHOP_DOMAIN=ag    # ag | office  — which worked example to use (see worksheets/pick-your-example.md)
